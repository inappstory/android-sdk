<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="BottomSheetLayout">
        <attr name="collapsedHeight" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="ReaderPager">

        <attr name="cs_readerTransitionAnimation" format="dimension">
            <enum name="cube" value="0" />
            <enum name="depth" value="1" />
        </attr>
        <attr name="cs_readerCloseOnSwipe" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ElasticDragDismissFrameLayout">
        <attr name="dragDismissDistance" format="dimension" />
        <attr name="dragDismissFraction" format="float" />
        <attr name="dragDismissScale" format="float" />
        <attr name="dragDismissEnableBottomDrag" format="boolean" />
        <attr name="dragElasticity" format="float" />
        <attr name="ignoreNestedScrollWarnings" format="boolean" />
        <attr name="enableScaleX" format="boolean" />
    </declare-styleable>

    <declare-styleable name="StoriesList">
        <attr name="cs_listIsFavorite" format="boolean" />
        <attr name="cs_feed" format="string" />
    </declare-styleable>

    <declare-styleable name="BannerCarousel">
        <attr name="cs_place_id" format="string" />
    </declare-styleable>

    <declare-styleable name="BannerList">
        <attr name="cs_banner_list_place_id" format="string" />
    </declare-styleable>

    <declare-styleable name="BannerGrid">
        <attr name="cs_banner_grid_place_id" format="string" />
    </declare-styleable>

    <declare-styleable name="IasDynamicGridLayout">
        <attr name="columnCount" format="integer" />
        <attr name="horizontalSpacing" format="dimension" />
        <attr name="verticalSpacing" format="dimension" />
        <attr name="rowAlignment" format="enum">
            <enum name="top" value="0" />
            <enum name="center" value="1" />
            <enum name="bottom" value="2" />
        </attr>
    </declare-styleable>
</resources>